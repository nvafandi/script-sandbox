{
  "name": "script-sandbox",
  "version": "1.1.0",
  "description": "MCP server (stdio) to run any script (PowerShell, bash, Python, Node, Ruby, Perl, Lua, PHP, R, Java, batch, VBScript) and any executable inside a lightweight sandbox: per-run working dir, minimal env, timeout, logs, and per-language guardrails.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sandbox",
    "script",
    "powershell",
    "python",
    "node",
    "bash",
    "ruby",
    "perl",
    "lua",
    "php",
    "java",
    "stdio",
    "ai-agent"
  ],
  "homepage": "https://github.com/nvafandi/script-sandbox",
  "bugs": {
    "url": "https://github.com/nvafandi/script-sandbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvafandi/script-sandbox.git"
  },
  "license": "MIT",
  "author": "Nurvan Afandi <nurvan.afandi@gmail.com>",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "script-sandbox": "src/server.js"
  },
  "files": [
    "src",
    "scripts",
    "test/config-check.mjs",
    "test/clients-check.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/smoke.js && node test/config-check.mjs && node test/clients-check.mjs",
    "setup:npm": "node scripts/setup-npm.js",
    "setup:clients": "node scripts/setup-clients.js",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  }
}
